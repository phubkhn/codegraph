{
  "name": "codegraph-mcp",
  "version": "0.1.0",
  "description": "Local-first code graph MCP server for Java/Spring and React/TypeScript codebases",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codegraph": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "npm run build && node dist/cli/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "picomatch": "^4.0.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
